# Zelvo installation settings (hardened Docker Compose, task F6).
# install.sh copies this file to .env (readable by root only) and replaces every "change-me" with a
# random value. Fill in the settings marked REQUIRED before the first start. Never share .env:
# it holds the installation's passwords. Keep a copy of it, and of secrets/master.key, somewhere
# safe outside this server (see docs/architecture/backup-restore.md).

COMPOSE_PROJECT_NAME=zelvo
# Observability (Prometheus, Tempo, Loki, Grafana) on this server; empty to leave them off (then
# also empty ZELVO_OTLP_ENDPOINT and ZELVO_OTLP_HTTP_ENDPOINT, and ZELVO_KEYCLOAK_TRACING=false).
COMPOSE_PROFILES=observability

# Production for every customer installation. Release builds only ever run under a license;
# CI's install test sets Staging so that its development build runs with the development license.
ZELVO_ENVIRONMENT=Production

# The release this installation runs (install.sh writes it; the updater changes it).
ZELVO_VERSION=
# This folder's absolute path (install.sh writes it).
ZELVO_COMPOSE_DIR=

# REQUIRED: the address people use, for example servicedesk.example.gov.ae. Ports 80 and 443 of
# this server must be reachable for it.
ZELVO_PUBLIC_HOST=
# REQUIRED: the address certificate authorities send notices to.
ZELVO_ACME_EMAIL=
# Empty: a certificate from Let's Encrypt. Offline networks: your own ACME server's directory
# address in ZELVO_ACME_CA, or "internal" for Caddy's own CA (tests only).
ZELVO_PUBLIC_TLS=
ZELVO_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ZELVO_HTTP_PORT=80
ZELVO_HTTPS_PORT=443
ZELVO_SPF_INCLUDE=
ZELVO_TIME_ZONE=Asia/Dubai

# REQUIRED: the organisation created on first start.
ZELVO_DEFAULT_TENANT=default
ZELVO_DEFAULT_TENANT_NAME_EN=
ZELVO_DEFAULT_TENANT_NAME_AR=

# REQUIRED: the mail server for notifications and sign-in codes. Security: StartTls, SslOnConnect
# or Auto (ZELVO_SMTP_STARTTLS is the same for Keycloak's sign-in emails).
ZELVO_SMTP_HOST=
ZELVO_SMTP_PORT=587
ZELVO_SMTP_SECURITY=StartTls
ZELVO_SMTP_STARTTLS=true
ZELVO_SMTP_USER=
ZELVO_SMTP_PASSWORD=
ZELVO_SMTP_FROM=

# Internal networks Zelvo may call (your mail servers, directories, gateways, self-hosted AI),
# in CIDR form, for example 10.20.0.0/16. Empty: public HTTPS addresses only.
ZELVO_INTERNAL_NETWORK_1=
ZELVO_INTERNAL_NETWORK_2=
# The Docker network the proxy reaches the API from (only it may forward client addresses).
ZELVO_DOCKER_NETWORK=172.16.0.0/12

# Stored secrets (A5): File uses secrets/master.key; Vault for HashiCorp Vault or OpenBao Transit
# (then also Secrets__Vault__* settings, see docs/architecture/secrets-encryption.md).
ZELVO_SECRETS_PROVIDER=File

# Backups (pgBackRest): every day at this time (ZELVO_TIME_ZONE), kept 35 days. The repository
# is the backup-repo volume; put it on another disk, or use S3-compatible storage:
# ZELVO_BACKUP_REPO_TYPE=s3 and the bucket, endpoint, region and keys below.
ZELVO_BACKUP_TIME=01:30
ZELVO_BACKUP_REPO_TYPE=posix
ZELVO_BACKUP_S3_BUCKET=
ZELVO_BACKUP_S3_ENDPOINT=
ZELVO_BACKUP_S3_REGION=
ZELVO_BACKUP_S3_KEY=
ZELVO_BACKUP_S3_KEY_SECRET=
# Backups are encrypted with this passphrase; without it they cannot be restored. Keep a copy
# with .env outside this server.
ZELVO_BACKUP_CIPHER_PASS=change-me

# Malware scanning: definitions are imported in Settings → Updates → Malware definitions, which
# also says whether ClamAV may download them from ClamAV's own servers (task M1).

# Telemetry to the collector; empty turns it off.
ZELVO_OTLP_ENDPOINT=http://otel-collector:4317
ZELVO_OTLP_HTTP_ENDPOINT=http://otel-collector:4318
ZELVO_KEYCLOAK_TRACING=true

# Passwords and secrets: random values made by install.sh.
POSTGRES_SUPERUSER=zelvo_owner
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_DB=zelvo
ZELVO_APP_DB_USER=zelvo_app
ZELVO_APP_DB_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PROVISIONER_SECRET=change-me
ZELVO_WEB_CLIENT_SECRET=change-me
ZELVO_TLS_TOKEN=change-me
RABBITMQ_USER=zelvo
RABBITMQ_PASSWORD=change-me
RABBITMQ_API_PASSWORD=change-me
RABBITMQ_WORKER_PASSWORD=change-me
OPENSEARCH_ADMIN_PASSWORD=change-me
OPENSEARCH_API_PASSWORD=change-me
OPENSEARCH_WORKER_PASSWORD=change-me
REDIS_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Ports on 127.0.0.1 only, for administrators on the server (SSH tunnel).
KEYCLOAK_ADMIN_PORT=8180
GRAFANA_PORT=3001
