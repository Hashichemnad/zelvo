            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"zelvo/zelvo-api\", http_route=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
