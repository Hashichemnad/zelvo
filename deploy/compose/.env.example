# Zelvo development stack settings.
# scripts/dev-up.sh copies this file to .env and replaces every "change-me" with a random value.
# Never commit .env.

COMPOSE_PROJECT_NAME=zelvo

# PostgreSQL: the superuser runs migrations; the application role cannot bypass row-level security.
POSTGRES_SUPERUSER=zelvo_owner
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_DB=zelvo
ZELVO_APP_DB_USER=zelvo_app
ZELVO_APP_DB_PASSWORD=change-me

# Tenant created on first start; the API uses it when a request names no tenant.
ZELVO_DEFAULT_TENANT=default
ZELVO_DEFAULT_TENANT_NAME_EN=Zelvo
ZELVO_DEFAULT_TENANT_NAME_AR=زيلفو

# Keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Service account the API uses to apply sign-in settings to tenant realms.
KEYCLOAK_PROVISIONER_SECRET=change-me
# Secret of the zelvo-web client in every tenant realm (the web app's server side).
ZELVO_WEB_CLIENT_SECRET=change-me
# Branding (F1): secret of the reverse proxy's TLS questions to the API.
ZELVO_TLS_TOKEN=change-me
# Development only: password of the ready-made users (requester@zelvo.test, agent@, lead@,
# approver@, admin@, executive@). Leave empty to create none. Never set it in production.
ZELVO_DEV_USERS_PASSWORD=change-me
# Development only: client secret of the UAE PASS mock (client ID zelvo-mock). Real UAE PASS
# credentials are entered in Settings → UAE PASS, never here.
UAEPASS_MOCK_CLIENT_SECRET=change-me

# RabbitMQ: administrator (management UI) and one user per service, with TLS (A5).
RABBITMQ_USER=zelvo
RABBITMQ_PASSWORD=change-me
RABBITMQ_API_PASSWORD=change-me
RABBITMQ_WORKER_PASSWORD=change-me

# OpenSearch (security plugin on, A5): administrator, and the API's and worker's users.
OPENSEARCH_ADMIN_PASSWORD=change-me
OPENSEARCH_API_PASSWORD=change-me
OPENSEARCH_WORKER_PASSWORD=change-me

# Malware scanning of attachments (B1). Scanning is on unless set to false (files are then
# marked "not scanned"). Offline installations: CLAMAV_NO_FRESHCLAMD=true, then import definition
# files with scripts/clamav-import-definitions.sh.
ZELVO_ATTACHMENT_SCANNING=true
CLAMAV_NO_FRESHCLAMD=false

# The cache (Valkey, Redis protocol)
REDIS_PASSWORD=change-me

# Outgoing email of notifications (task B5): one mail server for the installation. Empty values use
# Mailpit in development (http://localhost:8025). Set the password here, never in a committed file.
ZELVO_SMTP_HOST=
ZELVO_SMTP_PORT=
ZELVO_SMTP_SECURITY=
ZELVO_SMTP_USER=
ZELVO_SMTP_PASSWORD=
ZELVO_SMTP_FROM=

# Grafana (dashboards and alerts, http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Ports on this computer (bound to 127.0.0.1 only)
WEB_PORT=3000
API_PORT=8080
KEYCLOAK_PORT=8180
MAILPIT_PORT=8025
GREENMAIL_SMTP_PORT=3025
UAEPASS_MOCK_PORT=8095
RABBITMQ_MANAGEMENT_PORT=15672
OPENSEARCH_PORT=9200
POSTGRES_PORT=5432
REDIS_PORT=6379
GRAFANA_PORT=3001

# Reverse proxy (F1). Development: https://localhost:8443 with Caddy's own certificate authority.
# Installs set their public host, a real certificate (leave ZELVO_PUBLIC_TLS empty for ACME, or
# point it at their own ACME server with ZELVO_ACME_CA), ports 80 and 443, and the include their
# mail server needs in SPF records.
ZELVO_PUBLIC_HOST=localhost
ZELVO_PUBLIC_TLS=internal
ZELVO_HTTP_PORT=8088
ZELVO_HTTPS_PORT=8443
ZELVO_SPF_INCLUDE=

# Licensing (F3): ZELVO_DEVELOPMENT_LICENSE=false tries activation in development, with a key of
# your own from the signing tool (its id and public key below; never the private key). Installs
# set ZELVO_MACHINE_ID_FILE=/etc/machine-id.
ZELVO_DEVELOPMENT_LICENSE=true
ZELVO_DEV_SIGNING_KEY_ID=
ZELVO_DEV_SIGNING_PUBLIC_KEY=
ZELVO_MACHINE_ID_FILE=

# Updates (F4): the version of Zelvo's images, changed by the updater when it installs a package.
# ZELVO_COMPOSE_DIR is this directory's absolute path (scripts/dev-up.sh writes it).
ZELVO_VERSION=dev
ZELVO_COMPOSE_DIR=
