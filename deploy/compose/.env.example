# Zelvo development stack settings.
# scripts/dev-up.sh copies this file to .env and replaces every "change-me" with a random value.
# Never commit .env.

COMPOSE_PROJECT_NAME=zelvo

# PostgreSQL: the superuser runs migrations; the application role cannot bypass row-level security.
POSTGRES_SUPERUSER=zelvo_owner
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_DB=zelvo
ZELVO_APP_DB_USER=zelvo_app
ZELVO_APP_DB_PASSWORD=change-me

# Tenant created on first start; the API uses it when a request names no tenant.
ZELVO_DEFAULT_TENANT=default
ZELVO_DEFAULT_TENANT_NAME_EN=Zelvo
ZELVO_DEFAULT_TENANT_NAME_AR=زيلفو

# Keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Service account the API uses to apply sign-in settings to tenant realms.
KEYCLOAK_PROVISIONER_SECRET=change-me
# Secret of the zelvo-web client in every tenant realm (the web app's server side).
ZELVO_WEB_CLIENT_SECRET=change-me
# Development only: password of the ready-made users (requester@zelvo.test, agent@, lead@,
# approver@, admin@, executive@). Leave empty to create none. Never set it in production.
ZELVO_DEV_USERS_PASSWORD=change-me

# RabbitMQ and the cache (Valkey, Redis protocol)
RABBITMQ_USER=zelvo
RABBITMQ_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Ports on this computer (bound to 127.0.0.1 only)
WEB_PORT=3000
API_PORT=8080
KEYCLOAK_PORT=8180
MAILPIT_PORT=8025
RABBITMQ_MANAGEMENT_PORT=15672
OPENSEARCH_PORT=9200
POSTGRES_PORT=5432
REDIS_PORT=6379
