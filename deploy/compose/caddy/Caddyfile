# Zelvo's reverse proxy (task F1, product owner decision 2026-11-24): HTTPS in front of the web
# app, for the installation's own address and for tenants' verified custom domains.
#
# - Automatic certificates by ACME (Let's Encrypt by default, or the customer's own ACME server
#   for offline networks: ZELVO_ACME_CA), only for hosts Zelvo says a tenant verified ("ask").
# - Certificates a tenant uploaded in Settings → Branding come from Zelvo during the TLS
#   handshake ("get_certificate http"); Zelvo answers 204 for other hosts and ACME takes over.
# Both questions go to the API's internal address with a shared secret (ZELVO_TLS_TOKEN) and are
# never reachable from outside: the proxy forwards only to the web app.
{
	email {$ZELVO_ACME_EMAIL:admin@localhost}
	acme_ca {$ZELVO_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	on_demand_tls {
		ask http://api:8080/internal/tls/ask?token={$ZELVO_TLS_TOKEN}
	}
}

# Task E3: incoming messages from WhatsApp (Meta), SMS gateways (Twilio and others), Microsoft
# Teams and, from E7, monitoring alerts reach the API at /hooks/{tenant}/... with the raw body,
# so the providers' signatures can be checked. The tenant comes from the path and replaces any
# X-Zelvo-Tenant the caller sent; everything else still goes to the web app only.
(zelvo_hooks) {
	@hooks path_regexp hooks ^/hooks/([a-z0-9][a-z0-9-]{0,62})/(.+)$
	handle @hooks {
		rewrite * /api/v1/hooks/{re.hooks.2}?{query}
		reverse_proxy api:8080 {
			header_up X-Zelvo-Tenant {re.hooks.1}
		}
	}
}

# Task F4: while an update is installed the web app is stopped, and every page answers with the
# maintenance page (bilingual, its texts in maintenance/messages.json), which follows the
# updater's progress (status.json: state and step names only) and reloads when Zelvo is back.
# Incoming messages (zelvo_hooks) then get 503 too, and their providers send them again later.
(zelvo) {
	encode zstd gzip
	# Task F7 (ASVS V3.4.1): browsers keep to HTTPS for a year on the installation's address and
	# custom domains. Not for localhost, where it would also force every other local port onto
	# HTTPS. Without includeSubDomains: other hosts under a customer's domain are theirs to decide.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# Task F7 (ASVS V13.4.4): no TRACE or TRACK, which only echo requests back.
	@trace method TRACE TRACK
	handle @trace {
		respond 405
	}
	import zelvo_hooks
	handle_path /_zelvo/maintenance/* {
		root * /srv/maintenance
		file_server
	}
	handle /_zelvo/status.json {
		root * /srv/zelvo-status
		rewrite * /status.json
		header Cache-Control no-store
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
	handle_errors 502 503 504 {
		root * /srv/maintenance
		rewrite * /index.html
		header Cache-Control no-store
		file_server {
			status 503
		}
	}
}

# The installation's own address. Development uses Caddy's internal certificate authority.
{$ZELVO_PUBLIC_HOST:localhost} {
	tls {$ZELVO_PUBLIC_TLS:internal}
	import zelvo
}

# Tenants' custom domains.
https:// {
	tls {
		get_certificate http http://api:8080/internal/tls/certificate?token={$ZELVO_TLS_TOKEN}
		on_demand
	}
	import zelvo
}
