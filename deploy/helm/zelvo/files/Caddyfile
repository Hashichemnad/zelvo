# Zelvo's proxy on Kubernetes (task F6): the same routes as the Compose installs' Caddyfile
# (deploy/compose/caddy), listening on unprivileged ports as a non-root user. On-demand
# certificates only for hosts a tenant verified; tenants' uploaded certificates from the API.
{
	http_port 8080
	https_port 8443
	email {$ZELVO_ACME_EMAIL}
	acme_ca {$ZELVO_ACME_CA}
	on_demand_tls {
		ask http://{$ZELVO_API}/internal/tls/ask?token={$ZELVO_TLS_TOKEN}
	}
}

(zelvo) {
	encode zstd gzip
	# Task M1: the same security directives as the Compose Caddyfile (deploy/compose/caddy/Caddyfile);
	# scripts/check-caddy-security.sh fails CI when they differ.
	# zelvo:security-begin
	# ASVS V3.4.1: browsers keep to HTTPS for a year on the installation's address and custom
	# domains. Not for localhost, where it would also force every other local port onto HTTPS.
	# Without includeSubDomains: other hosts under a customer's domain are theirs to decide.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# ASVS V13.4.4: no TRACE or TRACK, which only echo requests back.
	@trace method TRACE TRACK
	handle @trace {
		respond 405
	}
	# zelvo:security-end
	@hooks path_regexp hooks ^/hooks/([a-z0-9][a-z0-9-]{0,62})/(.+)$
	handle @hooks {
		rewrite * /api/v1/hooks/{re.hooks.2}?{query}
		reverse_proxy {$ZELVO_API} {
			header_up X-Zelvo-Tenant {re.hooks.1}
		}
	}
	# Task M2 (pentest pack, open point 3): the REST API for integrations (API keys, OAuth
	# clients) and the MCP server at /api/v1, with the API's own rate limits and authentication;
	# HSTS and the TRACE refusal above apply as for pages. Tenants other than the installation's
	# default are named with the X-Zelvo-Tenant header. Provider webhooks stay under
	# /hooks/<tenant>/..., where the proxy names the tenant, so /api/v1/hooks is not routed.
	handle /api/v1/* {
		@api_hooks path /api/v1/hooks /api/v1/hooks/*
		respond @api_hooks 404
		reverse_proxy {$ZELVO_API} {
			# Streamable HTTP (MCP) and Server-Sent Events go out as they come.
			flush_interval -1
		}
	}
	@keycloak_admin path /auth/admin /auth/admin/*
	handle @keycloak_admin {
		respond 404
	}
	handle /auth/* {
		reverse_proxy {$ZELVO_KEYCLOAK}
	}
	handle {
		reverse_proxy {$ZELVO_WEB}
	}
}

{$ZELVO_PUBLIC_HOST} {
	{$ZELVO_PUBLIC_TLS_DIRECTIVE}
	import zelvo
}

https:// {
	tls {
		get_certificate http http://{$ZELVO_API}/internal/tls/certificate?token={$ZELVO_TLS_TOKEN}
		on_demand
	}
	import zelvo
}
