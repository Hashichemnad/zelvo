<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Zelvo.Tickets</RootNamespace>
    <Description>Zelvo ticket core (module 1): state rules, the tenant's ticket settings, incident search documents, the attachment store and malware scanning, and the worker jobs that close resolved tickets and scan attachments.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DnsClient" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Exports\Texts\*.json" LogicalName="Zelvo.Tickets.Exports.Texts.%(Filename).json" />
    <EmbeddedResource Include="Reports\Texts\*.json" LogicalName="Zelvo.Tickets.Reports.Texts.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zelvo.Data\Zelvo.Data.csproj" />
    <ProjectReference Include="..\Zelvo.Search\Zelvo.Search.csproj" />
    <ProjectReference Include="..\Zelvo.Integrations\Zelvo.Integrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zelvo.Api.Tests" />
  </ItemGroup>
</Project>
