<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Zelvo.Api.Tests</RootNamespace>
    <!-- Async test helpers need no synchronization context; inline request bodies read better than static arrays. -->
    <NoWarn>$(NoWarn);CA2007;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Task C1: format and rule cases shared with the web app. -->
    <None Include="..\..\..\..\tests\shared\form-cases.json" Link="form-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Zelvo.Api\Zelvo.Api.csproj" />
    <ProjectReference Include="..\..\Zelvo.Data\Zelvo.Data.csproj" />
    <ProjectReference Include="..\..\Zelvo.Search\Zelvo.Search.csproj" />
    <ProjectReference Include="..\..\Zelvo.Tickets\Zelvo.Tickets.csproj" />
    <ProjectReference Include="..\..\Zelvo.Integrations\Zelvo.Integrations.csproj" />
    <ProjectReference Include="..\..\Zelvo.Ai\Zelvo.Ai.csproj" />
    <ProjectReference Include="..\..\Zelvo.Secrets\Zelvo.Secrets.csproj" />
    <ProjectReference Include="..\..\Zelvo.Channels\Zelvo.Channels.csproj" />
    <ProjectReference Include="..\..\Zelvo.Connectors\Zelvo.Connectors.csproj" />
    <ProjectReference Include="..\..\Zelvo.Licensing\Zelvo.Licensing.csproj" />
    <ProjectReference Include="..\..\..\tools\Zelvo.SigningTool\Zelvo.SigningTool.csproj" />
    <ProjectReference Include="..\..\..\updater\Zelvo.Updater\Zelvo.Updater.csproj" />
  </ItemGroup>
</Project>
