<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Zelvo.Api</RootNamespace>
    <UserSecretsId>zelvo-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="AspNetCore.HealthChecks.Rabbitmq" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zelvo.Licensing.Abstractions\Zelvo.Licensing.Abstractions.csproj" />
  </ItemGroup>
  <!-- Development builds use the stub; release builds pass -p:ZelvoLicensingProject=<private project>. -->
  <ItemGroup Condition="'$(ZelvoLicensingProject)' == ''">
    <ProjectReference Include="..\Zelvo.Licensing.Development\Zelvo.Licensing.Development.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZelvoLicensingProject)' != ''">
    <ProjectReference Include="$(ZelvoLicensingProject)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zelvo.Api.Tests" />
  </ItemGroup>
</Project>
