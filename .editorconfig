root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated by `dotnet ef` (hand-written SQL is added to Up/Down only).
[src/api/Zelvo.Data/Migrations/{2*.cs,ZelvoDbContextModelSnapshot.cs}]
generated_code = true
